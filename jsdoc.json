{
    "plugins": ["./scripts/jsdoc-include-all.cjs"],
    "source": {
        "include": [
            "src",
            "cypress",
            "cypress.config.js",
            "eslint.config.js",
            "vite.config.js",
            "vitest.config.js"
        ],
        "includePattern": ".+\\.(js|vue)$"
    },
    "opts": {
        "destination": "./docs",
        "recurse": true,
        "tutorials": "./tutorials",
        "template": "./node_modules/docdash"
    },
    "docdash": {
        "tutorialsLabel": "Documents"
    }
}
