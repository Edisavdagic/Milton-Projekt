{
  "plugins": [],
  "source": {
    "include": ["src/utils", "src/composables", "src/stores"],
    "exclude": ["src/utils/__tests__"],
    "includePattern": ".+\\.(js)$"
  },
  "opts": {
    "destination": "./docs",
    "recurse": true,
    "tutorials": "./tutorials",
    "template": "./node_modules/docdash"
  },
  "docdash": {
    "tutorialsLabel": "Documents"
  }
}
