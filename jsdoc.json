{
  "plugins": ["./scripts/jsdoc-include-all.cjs"],
  "source": {
    "include": ["src"],
    "includePattern": ".+\\.(js|vue)$"
  },
  "opts": {
    "destination": "./docs",
    "recurse": true,
    "tutorials": "./tutorials",
    "template": "./node_modules/docdash"
  },
  "docdash": {
    "tutorialsLabel": "Documents"
  }
}
